# Provider: "nim" (NVIDIA NIM) or "gemini" (Gemini Flash via OpenAI-compatible endpoint)
LLM_PROVIDER=nim

# NVIDIA NIM (default when LLM_PROVIDER=nim)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PLANNER_MODEL=meta/llama-3.1-8b-instruct
CRITIC_MODEL=meta/llama-3.1-8b-instruct

# Gemini (used when LLM_PROVIDER=gemini; model fixed to gemini-2.5-flash)
GEMINI_API_KEY=

# Chroma
CHROMA_PERSIST_DIR=data/chroma

# API / Gateway (src/api) — API key -> client_id map, "key1:client_a,key2:client_b"
API_KEYS=
API_RATE_LIMIT_PER_MINUTE=60

# Observability (src/core/telemetry.py) — unset = spans/metrics stay no-op, no collector needed
OTEL_EXPORTER_OTLP_ENDPOINT=

# Real tool backends (src/tools/adapter.py RealToolAdapter, ENTERPRISE_ARCHITECTURE.md Phase 4)
# CRM + order lookup + refunds are backed by Stripe; KB search by Zendesk Guide. Unset = that
# backend fails closed with a clear config error instead of an unauthenticated request.
STRIPE_API_KEY=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
